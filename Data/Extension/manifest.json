{
	"manifest_version": 3,
	"name": "Subtitle Overlay",
	"version": "1.0",
	"description": "Shows another set of translated subittles as an overlay on videos.",

	"icons": {
		"128": "Photos/Icon.png"
	},

	"action": {
		"default_popup": "popup.html",
        "default_icon": {
            "128": "Photos/Icon.png"
        },
        "default_title": "Subtitle Overlay"
    },

	"permissions": [
		"scripting",
		"activeTab",
		"storage",
		"http://127.0.0.1:5002/*",
		"https://*/*",
  		"http://*/*"
	],

	"background": {
		"service_worker": "background.js"
	},

	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"css": ["overlay.css"],
			"all_frames": true,
			"run_at": "document_idle"
		}
	]
}